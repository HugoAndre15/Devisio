# Base de données
POSTGRES_VERSION=16
POSTGRES_DB=devisio_db
POSTGRES_USER=devisio_user
POSTGRES_PASSWORD=devisio_password

# Application Symfony
APP_ENV=dev
APP_DEBUG=true
APP_SECRET=your-secret-key-here

# URL de la base de données
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database:5432/${POSTGRES_DB}?serverVersion=${POSTGRES_VERSION}&charset=utf8"

# Mailer
# MAILER_DSN=smtp://mailer:1025 # Catcher
MAILER_DSN=gmail://contact.devisio@gmail.com:dotfoarhjpsnmtad@default # Vrai mail

